<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Debug builds also trust user-installed CAs so traffic can be inspected while testing. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
