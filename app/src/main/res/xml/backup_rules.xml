<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Nothing personal is backed up: settings, sessions and demo data stay on the device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
    <exclude domain="file" path="demo_media/" />
    <exclude domain="database" path="." />
</full-backup-content>
