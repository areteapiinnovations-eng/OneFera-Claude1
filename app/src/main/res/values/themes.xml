<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws all UI; this window theme only sets edge-to-edge defaults. -->
    <style name="Theme.OneFera" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/onefera_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.OneFera.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/onefera_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.OneFera</item>
    </style>
</resources>
