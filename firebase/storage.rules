rules_version = '2';

// OneFera Cloud Storage rules.
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if owner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Post media: photos (JPEG, ≤ 15 MB) and videos (MP4, ≤ 100 MB).
    match /posts/{uid}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if owner(uid) && (
        (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024)
        || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024));
      allow delete: if owner(uid);
    }

    match /stories/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if owner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
